# Database Configuration
# Neon PostgreSQL URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Safaricom Daraja STK Push Configuration
# Consumer Key and Secret from Daraja Portal
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
# Sandbox default shortcode: 174379, Production Paybill: 9410300
MPESA_SHORTCODE=174379
# Passkey from Daraja Portal (Lipa Na M-Pesa Online Passkey)
MPESA_PASSKEY=your_mpesa_passkey
# Environment: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox
# Public HTTPS URL of the backend (e.g. https://xxxx.ngrok-free.app/api/payments/callback)
MPESA_CALLBACK_URL=https://your-backend-domain.com/api/payments/callback

# Transactional Email Service Configuration (Resend)
EMAIL_PROVIDER_API_KEY=re_your_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="Event Registration"

# Frontend Configuration
# URL of the hosted frontend (for CORS and email redirect links)
FRONTEND_URL=http://localhost:5173
# Base URL for the QR code verification (typically pointing to frontend verification page)
QR_BASE_URL=http://localhost:5173/verify

# Security
# Random secret key for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
